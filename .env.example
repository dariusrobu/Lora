TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
DATABASE_URL=
TIMEZONE=Europe/Bucharest
MORNING_BRIEFING_TIME=08:00
EOD_REFLECTION_TIME=21:00
WEEKLY_REVIEW_DAY=sunday
LORA_API_SECRET=your_secret_here
SEMESTER_START_DATE=2026-02-23

# --- LLM LOCAL (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b  # sau llama3.2:3b, qwen2.5:7b etc.
OLLAMA_STRUCTURED_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- VOICE LOCAL (Faster-Whisper) ---
# La prima folosire, modelul este descărcat local; ulterior audio nu părăsește dispozitivul.
LOCAL_STT_MODEL=small
LOCAL_STT_DEVICE=auto
LOCAL_STT_COMPUTE_TYPE=int8

# --- COMPORTAMENT LORA ---
# true = confirmare înainte de scriere în DB (recomandat)
REQUIRE_CONFIRMATION=true

# --- DASHBOARD API ---
LORA_API_PASSWORD=schimba-cu-o-parola-puternica
JWT_SECRET=genereaza-un-secret-lung-si-aleator
LORA_ALLOWED_ORIGINS=http://localhost:5173,https://dashboardul-tau.example

# --- COUNCIL MULTI-AGENT SYSTEM ---
COUNCIL_API_SECRET=your-secret-from-council
COUNCIL_GROUP_CHAT_ID=

# --- ICLOUD CALENDAR ---
ICLOUD_USERNAME=email@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_CALENDAR_NAME=Lora
CALENDAR_SYNC_INTERVAL_MINUTES=15
CALENDAR_SECRET=your_secret_here

# --- OPTIONAL ---
OPENWEATHER_API_KEY=
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=
