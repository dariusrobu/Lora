TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
DATABASE_URL=
TIMEZONE=Europe/Bucharest
MORNING_BRIEFING_TIME=07:00
EOD_REFLECTION_TIME=21:00
WEEKLY_REVIEW_DAY=sunday
LORA_API_SECRET=your_secret_here
SEMESTER_START_DATE=2026-02-23

# --- LLM LOCAL (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b  # sau llama3.2:3b, qwen2.5:7b etc.
OLLAMA_STRUCTURED_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=llava
# Optional separate local vision model for food photos (no cloud models).
OLLAMA_FOOD_VISION_MODEL=qwen3-vl:2b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
OBSIDIAN_VAULT_PATH=/Users/robu/Lora/obsidian
OBSIDIAN_SYNC_ENABLED=true
OBSIDIAN_SYNC_INTERVAL_MINUTES=15
OBSIDIAN_SYNC_INCLUDE_FINANCE=true
OBSIDIAN_SYNC_INCLUDE_PERSONAL_NOTES=true
OBSIDIAN_PROCESS_INTERVAL_MINUTES=15
OBSIDIAN_PROCESS_MODEL=llama3.2:3b
OBSIDIAN_SUMMARY_PROVIDER=ollama
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
GROQ_SUMMARY_FALLBACK_MODEL=llama-3.1-8b-instant
# Lora Dev: Groq este opțional; fără cheie se folosește Ollama local.
GROQ_API_KEY=
GROQ_DEV_MODEL=openai/gpt-oss-20b
OLLAMA_DEV_MODEL=llama3.2:3b

# --- VOICE LOCAL (Faster-Whisper) ---
# La prima folosire, modelul este descărcat local; ulterior audio nu părăsește dispozitivul.
LOCAL_STT_MODEL=small
LOCAL_STT_DEVICE=auto
LOCAL_STT_COMPUTE_TYPE=int8

# --- COMPORTAMENT LORA ---
# true = confirmare înainte de scriere în DB (recomandat)
REQUIRE_CONFIRMATION=true

# --- DASHBOARD API ---
LORA_API_PASSWORD=schimba-cu-o-parola-puternica
JWT_SECRET=genereaza-un-secret-lung-si-aleator
STANDD_API_TOKEN=
LORA_ALLOWED_ORIGINS=http://localhost:5173,https://dashboardul-tau.example

# --- COUNCIL MULTI-AGENT SYSTEM ---
COUNCIL_API_SECRET=your-secret-from-council
COUNCIL_GROUP_CHAT_ID=

# --- ICLOUD CALENDAR ---
ICLOUD_USERNAME=email@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_CALENDAR_NAME=Lora
CALENDAR_SYNC_INTERVAL_MINUTES=60
CALENDAR_SECRET=your_secret_here

# --- OPTIONAL ---
OPENWEATHER_API_KEY=
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# --- NUTRITION REFERENCES (optional cloud lookup, not AI inference) ---
# Only food names/preparation/brands/barcodes are sent; no photos or meal history.
NUTRITION_CLOUD_ENABLED=false
# Free key: https://fdc.nal.usda.gov/api-key-signup/ (no permanent DEMO_KEY).
USDA_FDC_API_KEY=
# Open Food Facts read access needs no API key. Set an app contact if available.
OPENFOODFACTS_USER_AGENT=Lora/1.0 (personal nutrition assistant)
NUTRITION_CACHE_PATH=/Users/robu/Lora/data/nutrition/references.sqlite3
NUTRITION_CACHE_TTL_DAYS=30
